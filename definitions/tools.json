[
  {
    "id": "ssh_config",
    "application": "SSH",
    "category": "ssh",
    "kind": "file",
    "paths": ["~/.ssh/config"],
    "platforms": ["macos", "linux", "windows"],
    "sensitivity": "potential_secret"
  },
  {
    "id": "ssh_key_rsa",
    "application": "SSH Private Key (RSA)",
    "category": "ssh",
    "kind": "file",
    "paths": ["~/.ssh/id_rsa"],
    "platforms": ["macos", "linux", "windows"],
    "sensitivity": "highly_sensitive"
  },
  {
    "id": "ssh_key_ed25519",
    "application": "SSH Private Key (Ed25519)",
    "category": "ssh",
    "kind": "file",
    "paths": ["~/.ssh/id_ed25519"],
    "platforms": ["macos", "linux", "windows"],
    "sensitivity": "highly_sensitive"
  },
